# JWT
JWT_SECRET=change_me_in_every_environment
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800

# Set these when validating tokens issued by an external identity provider
# (Keycloak, Auth0, Cognito, etc.) instead of the local JwtService.
JWK_SET_URI=
ISSUER_URL=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# App
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
