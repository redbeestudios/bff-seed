# Files and directories excluded from the Docker build context

# Dependencies (installed inside the container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (compiled inside the container)
dist/
build/
*.tsbuildinfo

# Testing
coverage/
.nyc_output/
*.test.ts
*.spec.ts
test/
tests/
__tests__/

# Local dev tooling
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.gitlab-ci.yml
.github/
.gitlab/

# Docs
*.md
!README.md
docs/

# Local config
.env
.env.local
.env.*.local
*.local

# Logs
logs/
*.log

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Misc
.cache/
.temp/
.tmp/
*.tmp
*.bak
*.backup
Thumbs.db
examples/
